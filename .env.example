APP_NAME=SpaaLita
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public URL of this API (used for links to uploaded files).
APP_URL=http://localhost:5000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Customer website, used to build the password reset link.
FRONTEND_URL=http://localhost:3000

# Cost 10 matches the bcrypt hashes created by the Node.js backend.
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spaalita_database
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# JWT signing secret: at least 32 characters. Generate with: php artisan jwt:secret
JWT_SECRET=
# Token lifetimes in seconds (admin: 1 hour, user: 1 day).
JWT_ADMIN_TTL=3600
JWT_USER_TTL=86400

# Stripe (payment intents and webhook signature verification)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
